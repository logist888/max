---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Cta from '../components/Cta.astro';
import { ldBreadcrumbs, ldFaq } from '../lib/text.ts';

const crumbs = [
  { name: 'Главная', url: '/' },
  { name: 'Как выбрать профессию' },
];
const title = 'Как выбрать профессию: пошаговый разбор для школьника | Профориентация';
const description = 'Как выбрать профессию, если ничего не нравится или не знаешь, кем стать: с чего начать, 4 шага, частые ошибки. Не список профессий, а разбор от себя — интересы, сильные стороны, проверка реальностью.';

const faq = [
  {
    q: 'Как выбрать профессию, если ничего не нравится?',
    a: '«Ничего не нравится» чаще означает «мало пробовал» или «не с тем сравниваю». Начните не с профессий, а с занятий: что вы делаете, когда время идёт незаметно; за чем к вам обращаются друзья. Это указывает на сильные стороны, а профессии подбираются уже под них.',
  },
  {
    q: 'Что делать, если не знаю, кем стать?',
    a: 'Это нормально в 14–17 лет — устойчивые интересы ещё формируются. Не ищите одну «профессию мечты», сузьте поле: определите 2–3 сферы, которые не отталкивают, и посмотрите реальные профессии внутри них. Короткая диагностика помогает увидеть свои сильные стороны, с которых удобно стартовать.',
  },
  {
    q: 'Какую профессию выбрать, чтобы не пожалеть?',
    a: 'Устойчивый выбор — на пересечении трёх вещей: что получается (сильные стороны), что интересно (не выгораете) и что востребовано (есть работа и доход). Выбор только по зарплате или «за компанию» — частая причина сожалений через несколько лет.',
  },
  {
    q: 'В каком классе выбирать профессию?',
    a: 'Направление стоит нащупывать к 8–9 классу — от него зависит набор предметов и путь (колледж или 10–11 класс и вуз). Но это не финальное решение на всю жизнь: специальность можно сменить, а первые шаги важнее точности прогноза.',
  },
  {
    q: 'Как понять, какая профессия мне подходит?',
    a: 'Подходит та, где ваши сильные стороны — ежедневная работа, а не помеха. Проверяйте гипотезы: читайте, что реально делает специалист, пробуйте (стажировки, кружки, пробные задачи). Быстрый ориентир по сильным сторонам даёт тест — он не назначает профессию, а сужает поиск.',
  },
];

const jsonLd = [
  ldBreadcrumbs(crumbs.filter((c) => c.url).map((c) => ({ name: c.name, url: new URL(c.url!, Astro.site).href }))),
  ldFaq(faq),
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <Breadcrumbs items={crumbs} />
  <h1>Как выбрать профессию</h1>

  <p><strong>Выбор профессии начинается не со списка профессий, а с понимания себя</strong> —
    своих сильных сторон, интересов и того, что важно в работе. Список нужен потом, когда
    понятно, что искать. Ниже — как пройти этот путь по шагам, что делать, если «ничего не
    нравится» или «не знаю, кем стать», и каких ошибок избегать.</p>

  <Cta pageType="guide" zone="after-intro" />

  <h2>С чего начать — не с профессий, а с себя</h2>
  <p>Типичная ошибка — открыть перечень профессий и искать в нём «свою». Список из сотен
    названий не помогает выбрать: он перегружает и подталкивает выбирать по обложке — по
    статусу или зарплате. Продуктивнее обратный ход: сначала понять, <em>что вам даётся и
    что интересно</em>, и уже под это подбирать профессии. Тогда список из врага становится
    инструментом.</p>

  <h2>Как выбрать профессию: 4 шага</h2>
  <ol>
    <li><strong>Сильные стороны.</strong> Выпишите, что получается легче, чем у сверстников,
      и за чем к вам обращаются. Это фундамент — навыки развиваются быстрее там, где уже есть опора.</li>
    <li><strong>Интересы.</strong> Отметьте занятия, в которых время идёт незаметно. Совпадение
      интересов и сильных сторон — ядро будущей профессии.</li>
    <li><strong>Проверка реальностью.</strong> По каждой профессии-кандидату узнайте, <em>что
      специалист делает каждый день</em>, какая зарплата и где этому учат. Ожидание и
      реальность часто расходятся — лучше это увидеть заранее.</li>
    <li><strong>Короткий список.</strong> Оставьте 2–3 варианта и проверьте их на практике:
      стажировка, кружок, разговор с тем, кто в профессии, пробные задачи.</li>
  </ol>

  <h2>«Не знаю, кем стать» — это нормально</h2>
  <p>В 14–17 лет устойчивые интересы ещё формируются, и не знать точного ответа — не проблема,
    а честная стартовая точка. Не ищите единственную «профессию мечты»: сузьте поле до 2–3 сфер,
    которые не отталкивают, и разбирайтесь внутри них. Решение принимается не одним озарением, а
    серией маленьких проверок.</p>

  <h2>Как понять, какая профессия подходит именно вам</h2>
  <p>Подходит та профессия, где ваши сильные стороны — это ежедневная работа, а не то, что
    приходится преодолевать. Быстрый способ сориентироваться — пройти короткую диагностику
    сильных сторон: она не назначает профессию за вас, а показывает, с каких направлений вам
    удобнее начать поиск.</p>

  <Cta pageType="guide" zone="after-content" />

  <h2>От профессии — к образованию</h2>
  <p>Когда появились профессии-кандидаты, посмотрите, куда идти учиться и какие направления
    подготовки к ним ведут. Полезные разделы:</p>
  <ul>
    <li><a href="/professiya/">Список профессий</a> — что делает специалист, какие компетенции нужны, куда поступать.</li>
    <li><a href="/professii-vysokooplachivaemye/">Высокооплачиваемые профессии</a> — ориентир по зарплатам (данные Росстата).</li>
    <li><a href="/specialnosti/">Направления подготовки</a> — по каким специальностям учат в вузах.</li>
    <li><a href="/kuda-postupat-posle-11-klassa/">Куда поступать после 11 класса</a> — варианты и как выбрать.</li>
  </ul>

  <h2>Частые ошибки выбора</h2>
  <ul>
    <li><strong>Выбор по зарплате.</strong> Доход важен, но нелюбимая высокооплачиваемая работа
      быстро выгорает. Зарплата — фильтр, а не единственный критерий.</li>
    <li><strong>«За компанию» и по совету родителей.</strong> Чужой выбор не учитывает ваши
      сильные стороны. Мнение близких — вход в разговор, а не готовый ответ.</li>
    <li><strong>Одно решение навсегда.</strong> Первая профессия — не приговор. Важнее сделать
      осмысленный первый шаг, чем угадать на 40 лет вперёд.</li>
  </ul>

  <h2>Вопросы и ответы</h2>
  <dl class="faq">
    {faq.map((f) => (<><dt>{f.q}</dt><dd>{f.a}</dd></>))}
  </dl>

  <p class="meta">Материал носит справочный характер и помогает организовать выбор; он не
    заменяет очную консультацию специалиста по профориентации.</p>
</Base>
