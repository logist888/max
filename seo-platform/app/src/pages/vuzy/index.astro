---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import OrgRow from '../../components/OrgRow.astro';
import Cta from '../../components/Cta.astro';
import Filters from '../../components/Filters.astro';
import type { Facet } from '../../components/Filters.astro';
import { db } from '../../lib/data.ts';
import type { CatalogRow } from '../../lib/data.ts';

const { catalogRows, cardById, regions, cities, ugs, meta } = db();

// Правовая форма / статус / «филиал» — не различительная часть имени вуза.
// В shortName у 38% вузов имя начинается с «ФГБОУ ВО…», «АНОО ВО…», «Филиал…» —
// по такому первому символу алфавит бесполезен (680 вузов под «Ф»). Срезаем
// ведущие форменные и статус-токены (включая статус-акронимы НИУ/НИЯУ/НИТУ и пару
// «Национальный исследовательский …»), и по нему берём букву.
const FORM = new Set([
  'фгбоу', 'фгаоу', 'фгкоу', 'фгбну', 'фгау', 'фгбу', 'фгку', 'фкоу', 'фгбвоу', 'фгквоу',
  'фау', 'фбу', 'фгуп', 'фано', 'гоу', 'гбоу', 'гаоу', 'ноу', 'аноо', 'аноово', 'ано',
  'оано', 'чоу', 'очу', 'чу', 'поу', 'пооу', 'во', 'впо', 'филиал', 'предст',
  'представительство', 'ниу', 'нияу', 'ниту', 'иу',
]);
const GENERIC = new Set(['университет', 'институт', 'академия']);
const TRIM = /^[.,()«»"“”\-\s]+|[.,()«»"“”\-\s]+$/g;
const normTok = (t: string) => (t ?? '').toLowerCase().replace(TRIM, '');

function sortName(name: string): string {
  const toks = name.replace(/[«»"“”]/g, ' ').trim().split(/\s+/);
  let i = 0;
  while (i < toks.length && (normTok(toks[i]) === '' || FORM.has(normTok(toks[i])))) i += 1;
  if (normTok(toks[i]) === 'национальный' && normTok(toks[i + 1]) === 'исследовательский') {
    i += 2;
    if (GENERIC.has(normTok(toks[i]))) i += 1;
  }
  return (i < toks.length ? toks[i] : (toks[0] ?? '')).replace(TRIM, '');
}

function firstLetter(name: string): string {
  let ch = sortName(name).slice(0, 1).toUpperCase() || '#';
  if (ch === 'Ё') ch = 'Е';
  return /[А-ЯЁ]/.test(ch) ? ch : '#';
}

const groups: Record<string, CatalogRow[]> = {};
for (const row of catalogRows) (groups[firstLetter(row.shortName)] ??= []).push(row);
for (const l of Object.keys(groups)) {
  groups[l].sort((a, b) =>
    sortName(a.shortName).localeCompare(sortName(b.shortName), 'ru', { sensitivity: 'base' }));
}

const ORDER = 'АБВГДЕЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ';
const letters = Object.keys(groups).sort((a, b) => {
  if (a === '#') return 1;
  if (b === '#') return -1;
  return ORDER.indexOf(a) - ORDER.indexOf(b);
});

// data-* фасеты для клиентского фильтра. Форму обучения и укрупнённые группы вуза
// агрегируем на билд-тайме из org-cards (offers.form и programsByLevel.directions.ugs) —
// пайплайн не трогаем.
function vuzFacet(row: CatalogRow): Record<string, string> {
  const card = cardById.get(row.id);
  const forms = new Set<string>();
  const ugsCodes = new Set<string>();
  if (card) {
    for (const o of card.offers) if (o.form) forms.add(o.form);
    for (const g of card.programsByLevel) for (const d of g.directions) if (d.ugs) ugsCodes.add(d.ugs);
  }
  return {
    'data-region': row.regionKey,
    'data-city': row.cityKey,
    'data-kind': row.kind,
    'data-levels': (row.levels ?? []).join(','),
    'data-forms': [...forms].join(','),
    'data-ugs': [...ugsCodes].join(','),
    'data-budget': row.hasBudget ? '1' : '0',
    'data-dorm': row.dormitory ? '1' : '0',
    'data-mil': row.militaryDept ? '1' : '0',
    'data-cost-min': row.costRange ? String(row.costRange.min) : '',
    'data-cost-max': row.costRange ? String(row.costRange.max) : '',
  };
}

const regionOptions = [...regions]
  .sort((a, b) => a.displayName.localeCompare(b.displayName, 'ru'))
  .map((r) => ({ value: r.key, label: r.displayName }));
const cityOptions = [...cities]
  .sort((a, b) => a.displayName.localeCompare(b.displayName, 'ru'))
  .map((c) => ({ value: c.key, label: c.displayName, parent: c.regionKey }));
const ugsOptions = [...ugs]
  .sort((a, b) => a.code.localeCompare(b.code))
  .map((g) => ({ value: g.code, label: `${g.code} — ${g.name ?? ''}` }));

const facets: Facet[] = [
  { key: 'region', label: 'Регион', type: 'select', placeholder: '— любой регион —', options: regionOptions },
  { key: 'city', label: 'Город', type: 'select', placeholder: '— любой город —', options: cityOptions, dependsOn: 'region' },
  { key: 'ugs', label: 'Направление (укрупнённая группа)', type: 'select', placeholder: '— любая группа —', options: ugsOptions },
  { key: 'levels', label: 'Уровень', type: 'chip', chips: [
    { value: 'Бакалавриат', label: 'Бакалавриат' }, { value: 'Специалитет', label: 'Специалитет' },
    { value: 'Магистратура', label: 'Магистратура' }, { value: 'Аспирантура', label: 'Аспирантура' },
  ] },
  { key: 'forms', label: 'Форма обучения', type: 'chip', chips: [
    { value: 'Очная', label: 'Очная' }, { value: 'Очно-заочная', label: 'Очно-заочная' },
    { value: 'Заочная', label: 'Заочная' },
  ] },
  { key: 'kind', label: 'Тип', type: 'chip', chips: [
    { value: 'головной', label: 'Головной вуз' }, { value: 'филиал', label: 'Филиал' },
    { value: 'зарубежный', label: 'Зарубежный' },
  ] },
  { key: 'budget', label: 'Бюджетные места', type: 'toggle', toggleLabel: 'Есть бюджетные места' },
  { key: 'dorm', label: 'Общежитие', type: 'toggle', toggleLabel: 'Есть общежитие' },
  { key: 'mil', label: 'Военная подготовка', type: 'toggle', toggleLabel: 'Военная кафедра / УВЦ' },
  { key: 'cost', label: 'Стоимость платного', type: 'range', unit: '₽/год', min: 0, step: 10000 },
];

const title = `Каталог вузов России по алфавиту: ${catalogRows.length} организаций | ${meta.campaignYear}`;
const description = `Все вузы России из данных «ВУЗ-навигатора» Госуслуг: ${catalogRows.length} организаций. Фильтры по региону, городу, направлению, уровню, форме обучения, бюджету, общежитию и стоимости. Приём ${meta.campaignYear}.`;
---
<Base title={title} description={description}>
  <Breadcrumbs items={[{ name: 'Главная', url: '/' }, { name: 'Вузы' }]} />
  <h1>Каталог вузов России</h1>
  <p class="meta">{catalogRows.length} организаций. Отфильтруйте по параметрам или выберите первую букву
    названия — по акрониму или ключевому слову (правовая форма «ФГБОУ ВО», «Филиал» при сортировке не учитывается).</p>

  <Filters facets={facets} target="[data-filter-item]" itemNoun={['вуз', 'вуза', 'вузов']} />
  <p class="filters-empty" data-filters-empty hidden>По заданным фильтрам вузов не найдено. Снимите часть условий.</p>

  <div class="az-catalog">
    <div class="az-tabs" role="tablist" aria-label="Буквы алфавита">
      {letters.map((l) => (
        <a class="az-tab" href={`#az-${l}`} data-letter={l} role="tab" aria-selected="false">
          {l === '#' ? '#' : l}<span class="az-count">{groups[l].length}</span>
        </a>
      ))}
    </div>

    {letters.map((l) => (
      <section class="az-group" data-letter={l} id={`az-${l}`}>
        <h2 class="az-heading">{l === '#' ? 'Прочие' : l}</h2>
        <ul class="card-list">
          {groups[l].map((row) => <OrgRow row={row} facet={vuzFacet(row)} />)}
        </ul>
      </section>
    ))}
  </div>

  <Cta pageType="catalog" zone="after-row-10" />

  <style>
    .az-catalog { scroll-margin-top: 76px; }
    @media (max-width: 1023px) { .az-catalog { scroll-margin-top: 128px; } }
    .az-tabs {
      display: flex; flex-wrap: wrap; gap: var(--space-1);
      margin: var(--space-4) 0 var(--space-6); padding: var(--space-2);
      background: var(--surface-2); border: 1px solid var(--border); border-radius: var(--radius);
    }
    .az-tab {
      display: inline-flex; align-items: baseline; gap: 4px;
      min-width: 2.1em; justify-content: center;
      padding: 6px 9px; border-radius: 7px; font-weight: 600;
      color: var(--text); background: transparent; border: 1px solid transparent;
    }
    .az-tab:hover { background: var(--surface-2); text-decoration: none; }
    .az-tab .az-count { font-size: .7rem; font-weight: 500; color: var(--text-muted); }
    .az-tab[aria-selected="true"] { background: var(--accent); color: #fff; border-color: var(--accent); }
    .az-tab[aria-selected="true"] .az-count { color: rgba(255, 255, 255, .8); }
    .az-heading { margin: var(--space-6) 0 var(--space-3); font-size: 1.6rem; color: var(--accent-strong); scroll-margin-top: 110px; }
    /* JS-режим табов: показываем только активную группу. Без JS — все видны. */
    .js-tabs .az-group { display: none; }
    .js-tabs .az-group.active { display: block; }
    .js-tabs .az-heading { display: none; }
    /* Режим фильтрации: буквенные табы прячем, показываем все совпавшие группы с заголовками,
       пустые группы скрываем. */
    .az-catalog.filtering .az-tabs { display: none; }
    .az-catalog.filtering .az-group { display: block; }
    .az-catalog.filtering .az-heading { display: block; }
    .az-catalog.filtering .az-group.group-empty { display: none; }
  </style>

  <script>
    const wrap = document.querySelector<HTMLElement>('.az-catalog');
    if (wrap) {
      wrap.classList.add('js-tabs');
      const tabs = [...wrap.querySelectorAll<HTMLElement>('.az-tab')];
      const groupEls = [...wrap.querySelectorAll<HTMLElement>('.az-group')];
      const activate = (letter: string) => {
        groupEls.forEach((g) => g.classList.toggle('active', g.dataset.letter === letter));
        tabs.forEach((t) => t.setAttribute('aria-selected', String(t.dataset.letter === letter)));
      };
      tabs.forEach((t) => t.addEventListener('click', (e) => {
        e.preventDefault();
        const l = t.dataset.letter!;
        activate(l);
        history.replaceState(null, '', `#az-${l}`);
        wrap.scrollIntoView({ block: 'start' });
      }));
      const fromHash = decodeURIComponent(location.hash.replace('#az-', ''));
      activate(tabs.some((t) => t.dataset.letter === fromHash) ? fromHash : tabs[0].dataset.letter!);

      // Координация с фильтрами: при активном фильтре — режим результатов
      // (все группы видимы, пустые скрыты, буквенные табы спрятаны).
      const syncAz = (active: boolean) => {
        wrap.classList.toggle('filtering', active);
        groupEls.forEach((g) => {
          const has = active && g.querySelector('[data-filter-item]:not(.filtered-out)');
          g.classList.toggle('group-empty', active ? !has : false);
        });
      };
      document.addEventListener('filters:change', (e) => syncAz((e as CustomEvent).detail.activeCount > 0));
      // Начальное состояние (напр. открыли по ссылке с фильтром) — после того, как фильтр применился.
      setTimeout(() => syncAz(new URLSearchParams(location.search).toString().length > 0), 0);
    }
  </script>
</Base>
