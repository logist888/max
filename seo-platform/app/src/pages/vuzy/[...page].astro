---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import OrgRow from '../../components/OrgRow.astro';
import Cta from '../../components/Cta.astro';
import { db } from '../../lib/data.ts';

export function getStaticPaths() {
  // getStaticPaths изолирован от прочего frontmatter — константа внутри.
  const PER_PAGE = 24;
  const rows = db().catalogRows;
  const pageCount = Math.ceil(rows.length / PER_PAGE);
  return Array.from({ length: pageCount }, (_, i) => ({
    // Первая страница — /vuzy/, остальные — /vuzy/2/ … (страницы 2+ noindex, этап 2)
    params: { page: i === 0 ? undefined : String(i + 1) },
    props: { pageNum: i + 1, pageCount },
  }));
}

const { pageNum, pageCount } = Astro.props;
const { catalogRows, meta } = db();
const rows = catalogRows.slice((pageNum - 1) * 24, pageNum * 24);

const suffix = pageNum > 1 ? ` — страница ${pageNum}` : '';
const title = `Каталог вузов России: ${catalogRows.length} организаций${suffix} | ${meta.campaignYear}`;
const description = `Все вузы России из данных «ВУЗ-навигатора» Госуслуг: ${catalogRows.length} организаций, приём ${meta.campaignYear}.${suffix}`;

function pageUrl(n: number): string {
  return n === 1 ? '/vuzy/' : `/vuzy/${n}/`;
}
const window = [...new Set([1, pageNum - 1, pageNum, pageNum + 1, pageCount]
  .filter((n) => n >= 1 && n <= pageCount))].sort((a, b) => a - b);
---
<Base title={title} description={description} noindex={pageNum > 1}>
  <Breadcrumbs items={[{ name: 'Главная', url: '/' }, { name: 'Вузы' }]} />
  <h1>Каталог вузов России{suffix}</h1>
  <p class="meta">{catalogRows.length} организаций, отсортированы по числу направлений подготовки.</p>

  <ul class="card-list">
    {rows.map((row) => <OrgRow row={row} />)}
  </ul>

  <Cta pageType="catalog" zone="after-row-10" />

  <nav class="pagination" aria-label="Страницы каталога">
    {window.map((n, i) => (
      <>
        {i > 0 && window[i - 1]! + 1 < n && <span>…</span>}
        {n === pageNum
          ? <span aria-current="page">{n}</span>
          : <a href={pageUrl(n)}>{n}</a>}
      </>
    ))}
  </nav>
</Base>
