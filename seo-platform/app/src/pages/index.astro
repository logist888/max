---
import Base from '../layouts/Base.astro';
import { db } from '../lib/data.ts';
import { plural } from '../lib/text.ts';

const { catalogRows, cities, regions, directions, meta } = db();
const topCities = [...cities].sort((a, b) => b.orgCount - a.orgCount).slice(0, 12);
const title = 'Выбор вуза по данным, а не по слухам — каталог вузов России';
const description = `${catalogRows.length} вузов России с программами, стоимостью и бюджетными местами. Данные «ВУЗ-навигатора» Госуслуг, приём ${meta.campaignYear}.`;
const jsonLd = [{
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'Куда поступать',
  url: new URL('/', Astro.site).href,
}];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <section class="hero">
    <h1>Сначала — понять себя.<br />Потом — выбирать вуз.</h1>
    <p>Каталоги отвечают на вопрос «где учиться». Мы начинаем с вопроса
      «что вам подходит» — а уже потом показываем все {catalogRows.length} {plural(catalogRows.length, 'вуз', 'вуза', 'вузов')} России:
      программы, бюджетные места, цены. Только факты официальных данных.</p>
    <div class="actions">
      <a class="btn btn-primary" href="/test/">Узнать, насколько я определился</a>
      <a class="btn btn-secondary" href="/vuzy/">Смотреть каталог вузов</a>
    </div>
    <div class="chips">
      <span class="chip">{catalogRows.length} вузов</span>
      <span class="chip">{directions.length} направлений</span>
      <span class="chip">{cities.length} {plural(cities.length, 'город', 'города', 'городов')}</span>
      <span class="chip">Приём {meta.campaignYear}</span>
      <span class="chip">Без выдуманных рейтингов</span>
    </div>
  </section>

  <h2>Как это работает</h2>
  <ul class="card-list grid-3">
    <li class="card">
      <h3>1. Поймите, где вы</h3>
      <p class="meta">Тест из 5 вопросов покажет, что уже решено, а где выбор
        держится на чужих ожиданиях.</p>
      <p><a href="/test/">Пройти тест →</a></p>
    </li>
    <li class="card">
      <h3>2. Сузьте поле</h3>
      <p class="meta">894 направления в 57 группах: где учат, сколько стоит,
        есть ли бюджет — по каждому.</p>
      <p><a href="/specialnosti/">Смотреть направления →</a></p>
    </li>
    <li class="card">
      <h3>3. Сравните вузы</h3>
      <p class="meta">Карточки всех вузов России с программами и ценами
        приёмной кампании {meta.campaignYear}.</p>
      <p><a href="/vuzy/">Открыть каталог →</a></p>
    </li>
  </ul>

  <h2>Крупнейшие города</h2>
  <ul class="card-list grid-3">
    {topCities.map((c) => (
      <li class="card">
        <h3><a href={`/gorod/${c.slug}/`}>{c.displayName}</a></h3>
        <p class="meta">{c.orgCount} {plural(c.orgCount, 'вуз', 'вуза', 'вузов')} ·
          {c.directionCount} {plural(c.directionCount, 'направление', 'направления', 'направлений')}</p>
      </li>
    ))}
  </ul>

  <p class="meta">Все {regions.length} регионов — <a href="/regiony/">на одной странице</a>.</p>
</Base>
