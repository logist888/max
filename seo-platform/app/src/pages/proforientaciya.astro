---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Cta from '../components/Cta.astro';
import { ldBreadcrumbs, ldFaq } from '../lib/text.ts';
import { SCREENING_URL } from '../lib/links.ts';

const crumbs = [
  { name: 'Главная', url: '/' },
  { name: 'Профориентация' },
];
const title = 'Профориентация: что это и как проходит для школьников | Профориентация';
const description = 'Что такое профориентация простыми словами: как проходит, для какого возраста, что даёт и чего от неё не стоит ждать. Профориентация для школьников и подростков, онлайн и очно.';

const faq = [
  {
    q: 'Что такое профориентация простыми словами?',
    a: 'Профориентация — это помощь в выборе профессии и направления обучения на основе интересов, сильных сторон и особенностей человека. Не «тест, который скажет, кем быть», а процесс: понять себя, примерить профессии и составить план шагов.',
  },
  {
    q: 'В каком возрасте проходить профориентацию?',
    a: 'Первый заход полезен к 8–9 классу, когда встаёт выбор между колледжем и 10–11 классом и набором предметов. Но профориентация уместна и раньше (расширить кругозор), и позже (уточнить направление перед вузом или при смене пути).',
  },
  {
    q: 'Помогает ли профориентация на самом деле?',
    a: 'Она не гарантирует «единственно верную» профессию — это было бы обманом. Что она реально даёт: сужает поле выбора, показывает сильные стороны и снимает тревогу «я вообще не знаю, кем быть». Дальше нужны собственные пробы.',
  },
  {
    q: 'Чем тест отличается от консультации со специалистом?',
    a: 'Тест — быстрый ориентир: за несколько минут показывает склонности и сильные стороны. Консультация специалиста глубже: разбирает результаты, учитывает контекст семьи и помогает составить план. Тест — удобная точка входа, консультация — следующий шаг.',
  },
];

const jsonLd = [
  ldBreadcrumbs(crumbs.filter((c) => c.url).map((c) => ({ name: c.name, url: new URL(c.url!, Astro.site).href }))),
  ldFaq(faq),
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <Breadcrumbs items={crumbs} />
  <h1>Профориентация</h1>

  <p><strong>Профориентация — это помощь в выборе профессии и пути обучения</strong> на основе
    интересов, сильных сторон и особенностей человека. Это не одноразовый тест с приговором
    «кем быть», а процесс: понять себя → примерить профессии → составить план. Ниже — как он
    устроен, для какого возраста и чего от него стоит и не стоит ждать.</p>

  <Cta pageType="guide" zone="after-intro" />

  <h2>Как проходит профориентация</h2>
  <ol>
    <li><strong>Диагностика.</strong> Интересы, склонности, сильные стороны — через тест и/или
      беседу. Это отправная точка, а не вердикт.</li>
    <li><strong>Интерпретация.</strong> Результаты разбирают: что они значат, где сильные
      стороны пригождаются, а где будут мешать.</li>
    <li><strong>Примерка профессий.</strong> Под профиль подбираются реальные профессии — с
      описанием, что специалист делает каждый день, и куда идти учиться.</li>
    <li><strong>План шагов.</strong> Что попробовать (кружки, стажировки), какие предметы важны,
      какой путь — колледж или вуз.</li>
  </ol>

  <h2>Профориентация для школьников и подростков</h2>
  <p>Для подростка профориентация — это в первую очередь снятие тревоги и расширение картины:
    большинство профессий школьник просто не видит. Задача не «назначить» профессию в 15 лет, а
    дать язык для выбора и первые ориентиры. Чем раньше начаты пробы, тем спокойнее проходит
    выбор в 9 и 11 классе.</p>

  <h2>Профориентация онлайн: что можно и чего нельзя ждать</h2>
  <p>Онлайн-формат удобен для старта: быстрый тест, доступ из дома, мгновенный результат. Чего от
    него честно не стоит ждать — глубокого разбора вашей ситуации: это задача живого специалиста.
    Разумная схема — начать с онлайн-теста, а затем при необходимости идти на консультацию.</p>

  <Cta pageType="guide" zone="after-content" />

  <h2>С чего начать</h2>
  <ul>
    <li><a href={SCREENING_URL} rel="noopener">Пройти короткий тест</a> — ориентир по сильным сторонам.</li>
    <li><a href="/kak-vybrat-professiyu/">Как выбрать профессию</a> — пошаговый разбор.</li>
    <li><a href="/testy-na-proforientaciyu/">Тесты на профориентацию</a> — какие бывают и как выбрать.</li>
    <li><a href="/professiya/">Список профессий</a> — что делают специалисты и куда поступать.</li>
  </ul>

  <h2>Вопросы и ответы</h2>
  <dl class="faq">
    {faq.map((f) => (<><dt>{f.q}</dt><dd>{f.a}</dd></>))}
  </dl>

  <p class="meta">Материал носит справочный характер и не заменяет очную консультацию
    специалиста по профориентации.</p>
</Base>
