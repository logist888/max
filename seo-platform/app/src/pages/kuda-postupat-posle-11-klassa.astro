---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Cta from '../components/Cta.astro';
import { db } from '../lib/data.ts';
import { graph } from '../lib/graph.ts';
import { ldBreadcrumbs, ldFaq, plural } from '../lib/text.ts';

// On-data хаб: весь наш массив (вузы, направления, УГСН) — это и есть «после 11».
const { directions, ugs, catalogRows } = db();
const { professions } = graph();
const nDir = directions.length;
const nUgs = ugs.length;
const nVuz = catalogRows.length;
const nProf = professions.length;

const crumbs = [
  { name: 'Главная', url: '/' },
  { name: 'Куда поступать после 11 класса' },
];
const title = 'Куда поступать после 11 класса: как выбрать направление и вуз | Профориентация';
const description = `Куда поступать после 11 класса: варианты после школы, как выбрать направление и вуз, какие экзамены нужны. ${nDir} направлений подготовки и ${nVuz} вузов, профессии и профориентация.`;

const faq = [
  {
    q: 'Куда можно поступить после 11 класса?',
    a: `После 11 класса основной путь — вуз (бакалавриат или специалитет) по результатам ЕГЭ. Доступно ${nDir} направлений подготовки в ${nVuz} вузах. Можно также поступить в колледж (СПО) — туда берут и после 11, часто без ЕГЭ, по среднему баллу аттестата.`,
  },
  {
    q: 'Какие экзамены нужны, чтобы поступить после 11?',
    a: 'Набор ЕГЭ зависит от направления: русский язык обязателен, дальше — профильные предметы (например, математика и физика для инженерных, обществознание для экономических и юридических). Точный перечень и минимальные баллы всегда смотрите в правилах приёма конкретного вуза — они меняются по годам.',
  },
  {
    q: 'Куда поступить девушке или парню после 11 класса?',
    a: 'Профессия не имеет пола — выбор стоит делать по интересам и сильным сторонам, а не по «мужским» или «женским» спискам. Любое направление подготовки открыто независимо от пола; ориентируйтесь на то, что подходит именно вам.',
  },
  {
    q: 'Что делать, если не решил, куда поступать?',
    a: 'Не поздно определиться и в 11 классе. Сузьте выбор: пройдите короткий тест на сильные стороны, посмотрите профессии и ведущие к ним направления, сверьтесь с проходными баллами. Лучше осознанный первый шаг, чем случайное «куда возьмут».',
  },
];

const jsonLd = [
  ldBreadcrumbs(crumbs.filter((c) => c.url).map((c) => ({ name: c.name, url: new URL(c.url!, Astro.site).href }))),
  ldFaq(faq),
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <Breadcrumbs items={crumbs} />
  <h1>Куда поступать после 11 класса</h1>

  <p><strong>После 11 класса основной путь — вуз по результатам ЕГЭ</strong> (бакалавриат или
    специалитет); альтернатива — колледж (СПО). Главный вопрос не «куда возьмут», а «что
    подходит именно мне». Ниже — какие есть варианты, как выбрать направление и вуз и какие
    экзамены понадобятся. В каталоге — {nDir}&nbsp;{plural(nDir, 'направление', 'направления', 'направлений')}
    подготовки в {nVuz}&nbsp;{plural(nVuz, 'вузе', 'вузах', 'вузах')}.</p>

  <Cta pageType="guide" zone="after-intro" />

  <h2>Какие есть варианты после 11 класса</h2>
  <ul>
    <li><strong>Вуз (бакалавриат / специалитет)</strong> — по результатам ЕГЭ. Основной маршрут
      после 11 класса; выбор направлений самый широкий.</li>
    <li><strong>Колледж (СПО)</strong> — берут и после 11, часто без ЕГЭ, по аттестату; быстрее
      выход на работу.</li>
    <li><strong>Академический перерыв</strong> — год на подготовку, пересдачу ЕГЭ или пробы в
      профессии. Осознанная пауза лучше случайного выбора.</li>
  </ul>

  <h2>Как выбрать, куда поступать</h2>
  <p>Порядок тот же, что и при выборе профессии: сначала понять свои сильные стороны и интересы,
    потом подобрать профессии, и уже под них — направления и вузы. Обратный ход (сначала «модный»
    вуз, потом «кем там стать») чаще приводит к разочарованию.</p>
  <ol>
    <li>Определите сильные стороны — <a href="/test/">пройдите короткий тест</a> или разберитесь
      по шагам в материале <a href="/kak-vybrat-professiyu/">как выбрать профессию</a>.</li>
    <li>Посмотрите <a href="/professiya/">профессии</a> и <a href="/professii-vysokooplachivaemye/">зарплаты</a>,
      которые за ними стоят.</li>
    <li>Подберите <a href="/specialnosti/">направления подготовки</a> ({nUgs}&nbsp;укрупнённых
      групп, {nDir}&nbsp;направлений) и вузы, где они есть.</li>
  </ol>

  <h2>Какие экзамены нужны</h2>
  <p>Русский язык — обязателен для всех, дальше набор ЕГЭ зависит от направления (профильная
    математика и физика — для инженерных, обществознание — для экономики и права, биология и химия
    — для медицины). <strong>Точный перечень предметов и минимальные баллы смотрите в правилах
    приёма конкретного вуза</strong>: они различаются и меняются по годам, поэтому мы не приводим
    их списком, чтобы не ввести в заблуждение.</p>

  <h2>Куда поступить девушке или парню после 11</h2>
  <p>Один из частых запросов — «куда поступить девушке» или «парню». Честный ответ: <strong>профессия
    не имеет пола</strong>. Любое направление открыто независимо от пола, а выбирать стоит по
    интересам и сильным сторонам, а не по «мужским» или «женским» спискам. Поэтому вместо гендерных
    подборок — <a href="/test/">тест на сильные стороны</a> и <a href="/professiya/">каталог профессий</a>.</p>

  <Cta pageType="guide" zone="after-content" />

  <h2>Профессии после 11 класса</h2>
  <p>После 11 доступны профессии, требующие высшего образования, — от инженеров и врачей до
    IT-специалистов и юристов. Всего в каталоге {nProf}&nbsp;{plural(nProf, 'профессия', 'профессии', 'профессий')}
    с описанием, компетенциями и зарплатами. Начать удобно с
    <a href="/professii-vysokooplachivaemye/"> рейтинга по зарплатам</a> или
    <a href="/professiya/"> полного списка профессий</a>.</p>

  <h2>Вопросы и ответы</h2>
  <dl class="faq">
    {faq.map((f) => (<><dt>{f.q}</dt><dd>{f.a}</dd></>))}
  </dl>

  <p class="meta">Данные о вузах и направлениях — из источника приёмной кампании; проходные баллы
    и предметы ЕГЭ по программам источник не содержит, поэтому мы отсылаем к правилам приёма вузов.</p>
</Base>
