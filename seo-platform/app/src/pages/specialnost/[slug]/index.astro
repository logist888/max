---
import Base from '../../../layouts/Base.astro';
import Breadcrumbs from '../../../components/Breadcrumbs.astro';
import OrgRow from '../../../components/OrgRow.astro';
import Cta from '../../../components/Cta.astro';
import Filters from '../../../components/Filters.astro';
import type { Facet } from '../../../components/Filters.astro';
import { db } from '../../../lib/data.ts';
import { graph } from '../../../lib/graph.ts';
import { costPhrase, directionFaq, ldBreadcrumbs, ldFaq, plural } from '../../../lib/text.ts';
import { ege, EGE_SUBJECTS } from '../../../lib/ege.ts';
import {
  dirCardFacetData, dirOfferFacetData, regionFacet,
  FACET_KIND, FACET_FORM, FACET_BUDGET, FACET_COST, FACET_DORM, FACET_MIL,
} from '../../../lib/facets.ts';

export function getStaticPaths() {
  return db().directions.map((dir) => ({ params: { slug: dir.slug }, props: { dir } }));
}

const { dir } = Astro.props;
const { rowsByOkso, cardById, regions, combosCity, cityByKey, directions, meta } = db();
const rows = rowsByOkso.get(dir.okso) ?? [];
const code = dir.okso.replace(/^\d+\./, '');
const cost = costPhrase(dir.costRange);

// Фасеты списка вузов направления. Направление/уровень/группа фиксированы (не фасеты).
// Гео — только РЕГИОН (город даёт баг iOS + длинный список; город уже покрыт спицами
// «Где учиться по городам»). Форма/бюджет/цена — честно по офферам ИМЕННО этого ОКСО
// (dirOfferFacetData), не из агрегатов вуза. Регион-опции — только присутствующие.
const showFilters = rows.length >= 6;
const rowRegionKeys = new Set(rows.map((r) => r.regionKey));
const presentRegions = regions.filter((r) => rowRegionKeys.has(r.key));
const orgFacet = (row: typeof rows[number]) => ({
  ...dirCardFacetData(row),
  ...dirOfferFacetData(cardById.get(row.id), dir.okso),
});
const dirFacets: Facet[] = [
  regionFacet(presentRegions), FACET_KIND, FACET_FORM, FACET_BUDGET, FACET_COST, FACET_DORM, FACET_MIL,
];

// Города, где направление индексируемо (≥2 вузов) — спицы.
const comboLinks = combosCity
  .filter((c) => c.okso === dir.okso && c.indexable)
  .map((c) => ({ city: cityByKey.get(c.cityKey)!, count: c.orgIds.length }))
  .sort((a, b) => b.count - a.count);

// Другие уровни той же предметной линии: совпадает пятизначная часть кода
// без уровня (XX.__.YY): 09.03.01 ↔ 09.04.01.
const line = /^(\d+\.\d{2})\.\d{2}\.(\d{2})$/.exec(dir.okso);
const related = line
  ? directions.filter((d) => d.okso !== dir.okso &&
      d.okso.startsWith(line[1] + '.') && d.okso.endsWith('.' + line[2]))
  : [];

const title = `${dir.name} (${dir.level.toLowerCase()}): ${dir.orgCount} ${plural(dir.orgCount, 'вуз', 'вуза', 'вузов')} | ${meta.campaignYear}`;
const descParts = [
  `Направление ${code} «${dir.name}», ${dir.level.toLowerCase()}`,
  `${dir.orgCount} ${plural(dir.orgCount, 'вуз', 'вуза', 'вузов')} в ${dir.cityCount} ${plural(dir.cityCount, 'городе', 'городах', 'городах')}`,
];
if (dir.hasBudget) descParts.push('есть бюджетные места');
if (cost) descParts.push(`платно ${cost}`);
const description = descParts.join('. ') + '.';

const ugsName = db().ugs.find((g) => g.code === dir.ugsCode)?.name;
const crumbs = [
  { name: 'Главная', url: '/' },
  { name: 'Специальности', url: '/specialnosti/' },
  // Группа УГСН — только для ФГОС-направлений; у научных специальностей её нет.
  ...(dir.ugsCode
    ? [{ name: ugsName ?? `Группа ${dir.ugsCode}`, url: `/specialnosti/${dir.ugsCode}/` }]
    : []),
  { name: dir.name },
];
const faq = directionFaq(dir, meta.snapshotDate);
const jsonLd = [
  ldBreadcrumbs(crumbs.filter((c) => c.url).map((c) => ({
    name: c.name, url: new URL(c.url!, Astro.site).href,
  }))),
  ldFaq(faq),
];

// Профессии, сопоставленные с направлением (курируемо — сопоставление, не факт).
const professions = graph().byDirectionOkso.get(dir.okso) ?? [];

// Предметы ЕГЭ по направлению (перечень Минобрнауки) — только для бак/спец с данными.
// Русский обязателен всегда и выводится отдельно; различающие предметы — со ссылками.
const egeLink = new Map(EGE_SUBJECTS.map((e) => [e.key, e]));
const egeSubs = (ege().bySlug.get(dir.slug) ?? []).filter((k) => k !== 'русский язык');
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <Breadcrumbs items={crumbs} />
  <h1>{dir.name} — {code}</h1>
  <p class="meta">{dir.level}</p>

  <ul class="facts">
    <li><span class="label">Вузов с направлением</span> {dir.orgCount}</li>
    <li><span class="label">Городов</span> {dir.cityCount}</li>
    <li><span class="label">Бюджетные места</span>
      {dir.hasBudget ? 'есть' : `в выгрузке от ${meta.snapshotDate} не указаны`}</li>
    <li><span class="label">Стоимость платного обучения</span>
      {cost ?? <span class="missing">Информация отсутствует</span>}</li>
    {egeSubs.length > 0 && (
      <li><span class="label">Предметы ЕГЭ</span>
        русский язык{egeSubs.map((k) => {
          const e = egeLink.get(k);
          return <>, {e ? <a href={`/kuda-postupat-s-${e.slug}/`}>{k}</a> : k}</>;
        })}
        {' '}<span class="missing" style="color:var(--text-muted)">— по перечню Минобрнауки; точный набор в правилах приёма вуза</span></li>
    )}
  </ul>

  {professions.length > 0 && (
    <p class="notice">Кем можно работать (сопоставление по профилю, не официальная связь):
      {professions.map((pr, i) => (
        <>{i > 0 && ', '}<a href={`/professiya/${pr.slug}/`}>{pr.nameRu}</a></>
      ))}.
    </p>
  )}

  {related.length > 0 && (
    <p>Эта же предметная линия на других уровнях:
      {related.map((r, i) => (
        <>{i > 0 && ', '}<a href={`/specialnost/${r.slug}/`}>{r.level.toLowerCase()}</a></>
      ))}.
    </p>
  )}

  {comboLinks.length > 0 && (
    <>
      <h2>Где учиться по городам</h2>
      <ul class="card-list">
        {comboLinks.slice(0, 12).map((c) => (
          <li class="card">
            <h3><a href={`/specialnost/${dir.slug}/${c.city.slug}/`}>{c.city.displayName}</a></h3>
            <p class="meta">{c.count} {plural(c.count, 'вуз', 'вуза', 'вузов')}</p>
          </li>
        ))}
      </ul>
    </>
  )}

  <h2>Все вузы направления</h2>
  {showFilters && (
    <>
      <Filters facets={dirFacets} target="[data-filter-item]" itemNoun={['вуз', 'вуза', 'вузов']} />
      <p class="filters-empty" data-filters-empty hidden>По заданным фильтрам вузов с этим направлением не найдено. Снимите часть условий.</p>
    </>
  )}
  <ul class="card-list">
    {rows.map((row) => (
      showFilters ? <OrgRow row={row} facet={orgFacet(row)} /> : <OrgRow row={row} />
    ))}
  </ul>

  <Cta pageType="direction" zone="after-vuzy" />

  <h2>Вопросы и ответы</h2>
  <dl class="faq">
    {faq.map((f) => (<><dt>{f.q}</dt><dd>{f.a}</dd></>))}
  </dl>
</Base>
