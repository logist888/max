---
import Base from '../layouts/Base.astro';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import Cta from '../components/Cta.astro';
import { ldBreadcrumbs, ldFaq } from '../lib/text.ts';
import { SCREENING_URL } from '../lib/links.ts';

const crumbs = [
  { name: 'Главная', url: '/' },
  { name: 'Профориентация', url: '/proforientaciya/' },
  { name: 'Тесты на профориентацию' },
];
const title = 'Тесты на профориентацию: какие бывают и как выбрать | Профориентация';
const description = 'Тесты на профориентацию: какие бывают, чем тест на профессию отличается от теста на профориентацию, можно ли пройти бесплатно и онлайн и насколько результаты точны. Как использовать тест правильно.';

const faq = [
  {
    q: 'Какой тест на профориентацию лучше выбрать?',
    a: 'Универсального «лучшего» теста нет: одни оценивают интересы, другие — склонности или способности. Для старта подойдёт короткий тест на интересы и сильные стороны; для глубокого разбора — методики, которые интерпретирует специалист. Смотрите не на громкое название, а на то, что тест измеряет и кто разбирает результат.',
  },
  {
    q: 'Чем тест на профессию отличается от теста на профориентацию?',
    a: '«Тест на профессию» обычно обещает назвать конкретную профессию — к таким результатам стоит относиться осторожно, профессию не выбирают одним кликом. Тест на профориентацию честнее: он показывает склонности и сильные стороны, а профессии подбираются уже на их основе.',
  },
  {
    q: 'Можно ли пройти тест на профориентацию бесплатно и онлайн?',
    a: 'Да, бесплатные онлайн-тесты существуют и годятся как быстрый ориентир. Чего от бесплатного формата не стоит ждать — глубокой интерпретации под вашу ситуацию: это работа специалиста. Разумно начать с бесплатного теста, а при необходимости идти на консультацию.',
  },
  {
    q: 'Насколько точны тесты на профориентацию?',
    a: 'Тест — это ориентир, а не диагноз и не гарантия. Он сужает поле выбора и подсвечивает сильные стороны, но не заменяет собственные пробы: стажировки, кружки, разговоры с людьми из профессии. Точность выше, когда результат разбирает специалист.',
  },
];

const jsonLd = [
  ldBreadcrumbs(crumbs.filter((c) => c.url).map((c) => ({ name: c.name, url: new URL(c.url!, Astro.site).href }))),
  ldFaq(faq),
];
---
<Base title={title} description={description} jsonLd={jsonLd}>
  <Breadcrumbs items={crumbs} />
  <h1>Тесты на профориентацию</h1>

  <p><strong>Тест на профориентацию — это быстрый способ сориентироваться в выборе профессии</strong>:
    он показывает интересы, склонности и сильные стороны, но не назначает профессию за вас. Ниже —
    какие бывают тесты, чем «тест на профессию» отличается от теста на профориентацию, что реально
    даёт бесплатный онлайн-формат и как пользоваться результатом.</p>

  <Cta pageType="guide" zone="after-intro" />

  <h2>Какие бывают тесты</h2>
  <ul>
    <li><strong>На интересы</strong> — что нравится делать; с них удобно начинать.</li>
    <li><strong>На склонности</strong> — к каким типам деятельности есть предрасположенность.</li>
    <li><strong>На способности</strong> — что уже получается лучше (логика, речь, работа с людьми).</li>
  </ul>
  <p>По форме тесты бывают короткие (несколько минут, для ориентира) и развёрнутые опросники,
    результат которых разбирает специалист. Среди известных профессиональных методик — опросники
    Голланда и Климова; это инструменты специалистов, и в самостоятельном онлайн-формате они дают
    лишь приблизительную картину.</p>

  <h2>Тест на профессию или тест на профориентацию?</h2>
  <p>Запрос «тест на профессию» обычно ищет сервис, который назовёт конкретную профессию. Проблема
    в том, что надёжно «вычислить» профессию одним тестом нельзя — слишком много факторов. Честный
    результат — не ярлык «вы будете инженером», а набор сильных сторон и подходящих направлений,
    которые дальше проверяются на практике.</p>

  <h2>Бесплатно и онлайн: что можно, а что нет</h2>
  <p>Бесплатный онлайн-тест — хорошая точка входа: быстро, доступно, сразу виден результат. Чего он
    честно не заменит — разбора вашей ситуации специалистом и собственных проб. Используйте тест как
    первый шаг, а не как окончательный ответ.</p>

  <Cta pageType="guide" zone="after-content" />

  <h2>С чего начать</h2>
  <ul>
    <li><a href={SCREENING_URL} rel="noopener">Пройти короткий тест</a> — ориентир по сильным сторонам.</li>
    <li><a href="/kak-vybrat-professiyu/">Как выбрать профессию</a> — что делать с результатом теста.</li>
    <li><a href="/proforientaciya/">Профориентация</a> — как устроен весь процесс.</li>
    <li><a href="/professiya/">Список профессий</a> — куда смотреть после теста.</li>
  </ul>

  <h2>Вопросы и ответы</h2>
  <dl class="faq">
    {faq.map((f) => (<><dt>{f.q}</dt><dd>{f.a}</dd></>))}
  </dl>

  <p class="meta">Материал носит справочный характер. Онлайн-тест — ориентир, он не заменяет
    очную консультацию специалиста по профориентации.</p>
</Base>
