---
// Конверсионная вставка (этап 4, обновление 11.07.2026 по замечанию
// владельца): слой всегда видим. Пока внешняя цель из config/goals.json
// неактивна, CTA ведёт на внутренний мост — квиз /test/. Как только
// владелец вписывает url и active: true, кнопка начинает вести на цель
// с UTM-метками. На самой странице квиза внутренний фолбэк не рендерится
// (квиз не может звать сам себя).
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';

interface Props {
  pageType: string;
  zone: string;
}
const { pageType, zone } = Astro.props;

interface Goal {
  code: string; title: string; url: string;
  utm: Record<string, string>; active: boolean;
}
interface Config {
  goals: Goal[];
  placements: { pageType: string; zone: string; goal: string }[];
}
const config = JSON.parse(
  readFileSync(resolve(process.cwd(), 'config/goals.json'), 'utf8'),
) as Config;

const placement = config.placements.find(
  (p) => p.pageType === pageType && p.zone === zone,
);
const goal = placement
  ? config.goals.find((g) => g.code === placement.goal && g.active && g.url)
  : undefined;

let href = '';
let label = '';
let external = false;
if (goal) {
  const url = new URL(goal.url);
  for (const [k, v] of Object.entries(goal.utm)) {
    url.searchParams.set(k, v.replace('{page_type}', pageType));
  }
  href = url.href;
  label = goal.title;
  external = true;
} else if (pageType !== 'quiz') {
  href = '/test/';
  label = 'Пройти тест — 5 вопросов, 2 минуты';
}
---
{href && (
  <aside class="cta-block">
    <p class="cta-kicker">Следующий шаг</p>
    <p class="cta-lead">Факты собраны. Но какой вуз подходит именно вам —
      факты не скажут: сначала стоит понять свои сильные стороны.</p>
    <a class="btn btn-primary" href={href} rel={external ? 'noopener' : undefined}
      data-goal={goal?.code ?? 'quiz'} data-zone={zone} data-page-type={pageType}>
      {label}
    </a>
  </aside>
)}

<style>
  .cta-block {
    margin: var(--space-8) 0; padding: var(--space-6);
    border-radius: var(--radius);
    background: linear-gradient(135deg, var(--accent-soft), transparent 70%), var(--surface);
    border: 1px solid color-mix(in srgb, var(--accent) 30%, var(--border));
    box-shadow: var(--shadow-1);
  }
  .cta-kicker {
    margin: 0 0 var(--space-1); font-size: .78rem; font-weight: 600;
    text-transform: uppercase; letter-spacing: .06em; color: var(--accent);
  }
  .cta-lead { margin: 0 0 var(--space-4); max-width: 60ch; }
</style>
