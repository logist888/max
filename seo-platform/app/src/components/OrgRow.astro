---
import type { CatalogRow } from '../lib/data.ts';
import { costPhrase, plural } from '../lib/text.ts';

// facet — необязательные data-* атрибуты для клиентского фильтра (см. Filters.astro).
// Передаётся страницей каталога; при наличии карточка становится [data-filter-item].
interface Props { row: CatalogRow; facet?: Record<string, string> }
const { row, facet } = Astro.props;
const cost = costPhrase(row.costRange);
const attrs = facet ? { 'data-filter-item': '', ...facet } : {};
---
<li class="card" {...attrs}>
  <h3><a href={`/vuz/${row.slug}/`}>{row.shortName}</a></h3>
  <p class="meta">
    {row.cityName}, {row.regionKey}
    {row.kind === 'филиал' && ' · филиал'}
  </p>
  <p class="meta">
    {row.directionsCount > 0
      ? `${row.directionsCount} ${plural(row.directionsCount, 'направление', 'направления', 'направлений')}`
      : 'программы источником не выгружены'}
    {cost ? ` · платно ${cost}` : ''}
  </p>
  {/* Реальные признаки-флаги — семантическими бейджами (язык дизайн-системы:
     бюджет = «опора»/зелёный, военная = info/карамель). Отсутствие флага —
     молчание, а не красное «нет». Ничего не выдумываем: только то, что в данных. */}
  {(row.hasBudget || row.dormitory || row.militaryDept) && (
    <div class="badges">
      {row.hasBudget && <span class="badge badge--ok">Есть бюджет</span>}
      {row.dormitory && <span class="badge">Общежитие</span>}
      {row.militaryDept && <span class="badge badge--info">Военная кафедра</span>}
    </div>
  )}
</li>
