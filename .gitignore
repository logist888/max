# Конфиденциально: поток 1 (HNW), не для общего репозитория
docs/private/

# Python / окружение
__pycache__/
*.pyc
.venv/
venv/

# Сборки и временное
build/
*.tmp
scratch/
scratchpad/

# Node / инструменты рендеринга (Playwright и пр.)
node_modules/
package.json
package-lock.json

# Сырьё ингеста (большие бинарники); каталог держим через .gitkeep
raw/*
!raw/.gitkeep
